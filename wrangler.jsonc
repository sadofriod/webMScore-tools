{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webmscore-tools",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "webmscore.ashesborn.cloud",
      "custom_domain": true
    }
  ]
}